# ============================================================
# Meta Ads Agent — environment variables
# ============================================================
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored. These same vars need to be set in the Vercel project's
# environment (Settings → Environment Variables) for production deploys.
#
# Public vars (NEXT_PUBLIC_*) are inlined into the client bundle at build
# time. Server-only vars stay on the server.
#
# KIRK, 2026-08-19: this file is part of the migration prep trio (brand +
# ownership + connect). When the customer takes over the deployment, they
# copy this file to .env.local on their machine, fill in their own values,
# and the same env contract works for them.
# ============================================================

# ============================================================
# Supabase (REQUIRED)
# ============================================================
# Get these from: Supabase dashboard → Project → Settings → API
# The publishable key is the new "sb_publishable_..." format (formerly anon key).
# The secret key is the new "sb_secret_..." format (formerly service_role key).
# Keep the secret key server-only — never commit, never expose to the client.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# JWKS URL for verifying JWTs (Supabase populates this automatically —
# you usually don't need to change it). Format:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ============================================================
# Cron security (REQUIRED for production)
# ============================================================
# Random secret for the pg_cron jobs to authenticate when calling the
# Next.js API routes. Generate with: openssl rand -base64 32
# Must match the CRON_SECRET in your Supabase Edge Function env (if any).
CRON_SECRET=replace-with-openssl-rand-base64-32

# ============================================================
# Meta Marketing API (REQUIRED for Meta data sync)
# ============================================================
# Create a System User token in Meta Business Manager → Settings →
# System Users → Generate Token. Grant these scopes:
#   ads_read, ads_management, business_management,
#   pages_show_list, pages_read_engagement, pages_read_user_content
# Tokens are long-lived by default; rotate every 90 days.

META_SYSTEM_USER_TOKEN=EAAxxxxxxx...your-long-lived-token...xxx
META_BUSINESS_ID=123456789012345
META_AD_ACCOUNT_ID=act_123456789012345
META_PAGE_IDS=1234567890,0987654321

# ============================================================
# App URLs
# ============================================================
# NEXT_PUBLIC_APP_URL: where the app is served. Used for OAuth redirects,
#   email links, etc. Set to your production URL (e.g. https://app.example.com).
# NEXT_PUBLIC_SITE_URL: alias for NEXT_PUBLIC_APP_URL — both are read by
#   different parts of the code, kept in sync for clarity.
# For Vercel preview deploys the app uses window.location.origin at runtime,
# so these are mostly for production. Defaults if unset: localhost:4000.

NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ============================================================
# Demo mode (DO NOT enable in customer production)
# ============================================================
# Set to "true" to enable the 1-click demo sign-in button on /login.
# This is for Kirk's demo deployment only — customers taking over the
# codebase should leave this UNSET (or set to "false") to keep the
# production magic-link flow.
#
# KIRK, 2026-08-16: the demo button does server-side session minting via
# supabase.auth.admin.generateLink + /auth/v1/verify. Safe in the demo
# because the seeded users are *.local placeholders, but customers using
# real emails should NOT enable this.

NEXT_PUBLIC_DEMO_LOGIN=false

# ============================================================
# Brand env vars (login page only — dashboard reads from public.tenant_brand)
# ============================================================
# The login page can't read tenant_brand (no signed-in user at /login), so
# it falls back to these NEXT_PUBLIC_* env vars. The dashboard's header,
# sidebar, and hero read from public.tenant_brand via the get_tenant_brand
# RPC — drop a row in there on cutover and the whole UI re-skins.

NEXT_PUBLIC_PRODUCT_NAME=Comedy Club Ads
NEXT_PUBLIC_BRAND_DISPLAY_NAME=Comedy Club Co
NEXT_PUBLIC_BRAND_WORDMARK_BOLD=Comedy Club
NEXT_PUBLIC_BRAND_WORDMARK_LIGHT=Co.
NEXT_PUBLIC_BRAND_TAGLINE=Where the punchline lives.

# ============================================================
# Agent config
# ============================================================
# Version string used by the agent layer to track which model + prompt
# produced a given recommendation / alert. Bump on prompt changes.

AGENT_VERSION=1.0.0

# ============================================================
# Deploy (Vercel only — set automatically by Vercel, no manual edit needed)
# ============================================================
# VERCEL_OIDC_TOKEN is auto-populated by Vercel in build + runtime
# environments. Used by scripts/push-vercel-env.ts to push env vars to
# the Vercel project via the management API.
# Do NOT set this in .env.local — Vercel sets it itself.

# VERCEL_OIDC_TOKEN=
