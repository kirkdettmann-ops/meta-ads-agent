@echo off
REM Store the GitHub PAT in Windows Credential Manager under the standard
REM target name git uses for credential.helper = manager.
REM
REM After this runs, `git push origin main` should succeed without
REM prompting for credentials.

setlocal
set "TOKEN=%~1"
if "%TOKEN%"=="" (
  echo Usage: setup-git-credential.cmd ^<PAT^>
  exit /b 2
)

REM The /generic target name "git:https://github.com" is what git's
REM "manager" credential helper looks up automatically. The username is
REM arbitrary for token-based auth (some tools require it to match the
REM GitHub username; "x-access-token" also works, but a real username
REM matches the git remote helper's expectations).
cmdkey /generic:"git:https://github.com" /user:"kirkdettmann-ops" /pass:"%TOKEN%"
if errorlevel 1 (
  echo cmdkey failed.
  exit /b 1
)

echo Stored credential for git:https://github.com (user=kirkdettmann-ops) in Windows Credential Manager.
exit /b 0
