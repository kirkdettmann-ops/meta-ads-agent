# ==========================================
# Supabase (Kirk's personal org)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Database URL (for scripts/migration tooling)
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# Cron secret (used to authenticate cron route handlers)
CRON_SECRET=generate-a-random-string-here

# ==========================================
# Meta (filled in by Nils later)
# ==========================================
# System User token (long-lived, per Business)
META_SYSTEM_USER_TOKEN=
# Business Manager ID
META_BUSINESS_ID=
# Ad Account ID
META_AD_ACCOUNT_ID=
# API version
META_API_VERSION=v23.0

# ==========================================
# LLM (via matrix MCP — per-tenant budget)
# ==========================================
# MCP endpoint and key
MCP_LLM_ENDPOINT=
MCP_LLM_KEY=

# ==========================================
# App
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:4000
